# backend/.env.example
#
# 이 파일을 backend/.env로 복사한 뒤 아래 값들을 채워 넣으세요. .env는 절대
# git에 커밋하지 마세요(추후 git 초기화 시 .gitignore에 반드시 추가).
#
# cp .env.example .env

# --- JWT 시크릿 (필수) ---
# 미설정 시 앱이 아예 시작하지 않습니다(fail-closed). 서버가 재시작될 때마다
# 시크릿이 바뀌면 그 순간까지 발급된 로그인 세션이 전부 무효화되는 사고가
# 나기 때문에, 최초 1회 아래 명령으로 생성한 값을 고정해서 씁니다.
#
#   openssl rand -hex 32
#
# (openssl이 없는 환경이면: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=

# --- Admin/Internal API 키 (필수 - 해당 라우터 사용 시) ---
# /api/v1/admin/*, /api/v1/internal/* 호출 시 X-API-Key 헤더로 보낼 값입니다.
# 미설정 시 해당 라우터는 503으로 막힙니다(fail-closed). 위와 동일한 방식으로 생성하세요.
#
#   openssl rand -hex 32
ADMIN_API_KEY=
INTERNAL_API_KEY=

# --- Claude API (선택 - Layer4 설명 에이전트용) ---
# 미설정/호출 실패 시 SHAP 템플릿으로 자동 폴백하므로 없어도 앱은 정상 동작합니다.
ANTHROPIC_API_KEY=

# --- DB (선택) ---
# 미설정 시 backend/data/app.db(SQLite)를 사용합니다. Postgres로 전환하려면
# 커넥션 문자열만 바꾸면 됩니다(예: postgresql://user:pass@host:5432/dbname).
# DATABASE_URL=

# 파이프라인 산출물 경로. 미설정 시 data/processed가 있으면 우선 사용하고,
# 새 clone처럼 없으면 추적된 합성 데모 산출물 data/processed_large로 폴백합니다.
# PIPELINE_DATA_DIR=C:/absolute/path/to/processed

# --- 온통청년 Open API (선택 - 정책 추천 신청 URL 실시간 매칭용) ---
# 미설정/호출 실패 시 정책 추천 응답의 url 필드가 null로 폴백하므로 없어도
# 앱은 정상 동작합니다. https://www.youthcenter.go.kr 마이페이지에서 발급.
YOUTHCENTER_API_KEY=

# --- 시민 API 요청 제한 (선택, 단일 프로세스 기준 분당 횟수) ---
AUTH_RATE_LIMIT_PER_MINUTE=30
DIAGNOSE_RATE_LIMIT_PER_MINUTE=60
EXPLANATION_RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENT_BUCKETS=10000

# 웹 대시보드 허용 origin(쉼표 구분). 운영에서는 실제 HTTPS 도메인으로 교체하세요.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 정책 이용 피드백 (선택) ---
# 행정 집계에서 세부 분포를 공개할 최소 고유 응답자 수입니다(최소 2, 기본 5).
FEEDBACK_MIN_AGGREGATE_SIZE=5
POLICY_DEMAND_REWARD_AMOUNT=1000
POLICY_DEMAND_COOLDOWN_DAYS=90
# 단계별 Mock 리워드 금액(원). 실제 동백전 Provider가 붙기 전에는 mock_paid로 기록됩니다.
FEEDBACK_REWARD_APPLIED_AMOUNT=500
FEEDBACK_REWARD_SELECTED_AMOUNT=500
FEEDBACK_REWARD_REJECTED_AMOUNT=500
FEEDBACK_REWARD_USING_AMOUNT=700
FEEDBACK_REWARD_COMPLETED_AMOUNT=1000
