# web-dashboard/.env.example
#
# 이 파일을 web-dashboard/.env로 복사하세요.
# cp .env.example .env

# 백엔드 API 주소. 로컬에서 `uvicorn app.main:app --reload`로 backend/를 띄웠다면
# 기본값 그대로 두면 됩니다.
VITE_API_BASE_URL=http://localhost:8000

# Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키.
# Web 플랫폼 도메인에 http://localhost:5173 등록 필요.
VITE_KAKAO_MAP_APP_KEY=
